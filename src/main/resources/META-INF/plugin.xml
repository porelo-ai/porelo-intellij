<idea-plugin>
    <id>org.fuin.porelo</id>
    <name>Porelo</name>
    <vendor url="https://porelo-ai.github.io">Porelo</vendor>
    <description><![CDATA[
    Review an agent's waiting work in IntelliJ IDEA: see what waits at Porelo's gate, read its diff in the IDE,
    and approve or reject it - without checking anything out, building it or running it.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Porelo" anchor="left" icon="AllIcons.Toolwindows.ToolWindowChanges"
                    factoryClass="org.fuin.porelo.intellij.ide.PoreloToolWindowFactory"/>
        <notificationGroup id="Porelo" displayType="BALLOON"/>
        <fileEditorProvider implementation="org.fuin.porelo.intellij.ide.ReviewEditorProvider"/>
        <diff.DiffExtension implementation="org.fuin.porelo.intellij.review.ReviewDiffExtension"/>
    </extensions>

    <applicationListeners>
        <listener class="org.fuin.porelo.intellij.ide.PoreloStartup" topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>
</idea-plugin>
